{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.11.0",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "22.11.0",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.11.0",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.11.0",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true"
      },
      "cache": {
        "key": "android-no-read-media-v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}