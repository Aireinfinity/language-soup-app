{
  "expo": {
    "name": "Language Soup",
    "slug": "language-soup-mobile",
    "version": "1.0.4",
    "scheme": "languagesoup",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aireinfinity.languagesoup",
      "buildNumber": "23",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record voice memos for language practice.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.aireinfinity.languagesoup",
      "versionCode": 23,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/icon.png",
        "color": "#FF6B35"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "14.0"
          }
        }
      ],
      "expo-asset",
      "expo-audio",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Language Soup to access your photos to set your profile picture"
        }
      ]
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "affb0dd3-57d0-467c-b84c-d08c10e3b9ce"
      }
    }
  }
}