# Copy to .env and fill in real values. Used by: supabase functions serve (local) and as reference when setting Supabase Edge Function secrets.
# After rotating secrets, re-set all of these in Supabase Dashboard → Project Settings → Edge Functions → Secrets.

# Translation (dashboard + send-scheduled-challenges + auto-send-challenges)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Mooré pipeline (translate-huggingface)
HUGGINGFACE_API_KEY=

# Optional: translate-modernmt if you use it
MODERNMT_API_KEY=

# Voice feedback (voice-feedback)
OPENAI_API_KEY=
GROQ_API_KEY=

# Supabase injects these in production; only needed for local serve if not linked
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
